  "discriminator": {
    "mapping": {
      "clock.probe": "#/$defs/ClockProbe",
      "heartbeat.pong": "#/$defs/HeartbeatPong",
      "participant.readiness": "#/$defs/ParticipantReadiness",
      "playback.pause": "#/$defs/Pause",
      "playback.play": "#/$defs/Play",
      "playback.seek": "#/$defs/Seek",
      "playback.select": "#/$defs/SelectTrack",
      "reaction.send": "#/$defs/SendReaction",
      "room.snapshot.request": "#/$defs/SnapshotRequest",
      "sync.telemetry": "#/$defs/Telemetry"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClockProbe"
    },
    {
      "$ref": "#/$defs/HeartbeatPong"
    },
    {
      "$ref": "#/$defs/SnapshotRequest"
    },
    {
      "$ref": "#/$defs/ParticipantReadiness"
    },
    {
      "$ref": "#/$defs/SelectTrack"
    },
    {
      "$ref": "#/$defs/Play"
    },
    {
      "$ref": "#/$defs/Pause"
    },
    {
      "$ref": "#/$defs/Seek"
    },
    {
      "$ref": "#/$defs/Telemetry"
    },
    {
