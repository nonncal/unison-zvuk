      "additionalProperties": false,
      "properties": {
        "positionMs": {
          "maximum": 900000,
          "minimum": 0,
          "title": "Positionms",
          "type": "integer"
        }
      },
      "required": [
        "positionMs"
      ],
      "title": "SeekPayload",
      "type": "object"
    },
    "SelectPayload": {
      "additionalProperties": false,
      "properties": {
        "trackId": {
          "format": "uuid",
          "title": "Trackid",
          "type": "string"
        }
      },
      "required": [
        "trackId"
      ],
      "title": "SelectPayload",
      "type": "object"
    },
    "SelectTrack": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "expectedPlaybackRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expectedplaybackrevision",
          "type": "integer"
        },
        "type": {
          "const": "playback.select",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SelectPayload"
        }
      },
      "required": [
        "v",
        "requestId",
        "expectedPlaybackRevision",
        "type",
        "payload"
      ],
      "title": "SelectTrack",
      "type": "object"
    },
    "SendReaction": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "expectedPlaybackRevision": {
          "default": null,
          "title": "Expectedplaybackrevision",
          "type": "null"
        },
        "type": {
          "const": "reaction.send",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ReactionPayload"
        }
      },
      "required": [
        "v",
        "requestId",
        "type",
        "payload"
      ],
      "title": "SendReaction",
      "type": "object"
    },
    "SnapshotRequest": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "expectedPlaybackRevision": {
          "default": null,
          "title": "Expectedplaybackrevision",
          "type": "null"
        },
        "type": {
          "const": "room.snapshot.request",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      },
      "required": [
        "v",
        "requestId",
        "type",
        "payload"
      ],
      "title": "SnapshotRequest",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "requestId": {
          "format": "uuid",
          "title": "Requestid",
          "type": "string"
        },
        "expectedPlaybackRevision": {
          "default": null,
          "title": "Expectedplaybackrevision",
          "type": "null"
        },
        "type": {
          "const": "sync.telemetry",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/TelemetryPayload"
        }
      },
      "required": [
        "v",
        "requestId",
        "type",
        "payload"
      ],
      "title": "Telemetry",
      "type": "object"
    },
    "TelemetryPayload": {
      "additionalProperties": false,
      "properties": {
        "trackId": {
          "format": "uuid",
          "title": "Trackid",
          "type": "string"
        },
        "mediaVersion": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mediaversion",
          "type": "string"
        },
        "driftMs": {
          "maximum": 900000,
          "minimum": -900000,
          "title": "Driftms",
          "type": "integer"
        },
        "rttMs": {
          "maximum": 60000,
          "minimum": 0,
          "title": "Rttms",
          "type": "integer"
        },
        "localState": {
          "enum": [
            "playing",
            "paused",
            "buffering",
            "autoplayBlocked",
            "error"
          ],
          "title": "Localstate",
          "type": "string"
        }
      },
      "required": [
        "trackId",
        "mediaVersion",
        "driftMs",
        "rttMs",
        "localState"
      ],
      "title": "TelemetryPayload",
      "type": "object"
    }
