          "title": "Expectedplaybackrevision",
          "type": "integer"
        },
        "type": {
          "const": "playback.seek",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/SeekPayload"
        }
      },
      "required": [
        "v",
