{
  "name": "unison-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:test": "node scripts/test-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audio:generate": "node scripts/generate-demo-audio.mjs",
    "audio:check": "node scripts/generate-demo-audio.mjs --check",
    "format": "prettier --write src tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test:e2e:api": "UNISON_E2E_MODE=api playwright test"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "ajv": "^8.20.0",
    "lossless-json": "^4.3.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
