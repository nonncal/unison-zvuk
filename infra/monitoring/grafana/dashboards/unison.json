{
  "uid": "unison-overview",
  "title": "Unison — приложение и аудио",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "unison"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API доступен",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"unison-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "WebSocket подключения",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "unison_ws_connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Активные комнаты",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "unison_active_rooms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Обработчик аудио доступен",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "unison_audio_worker_online",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP запросы в секунду",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(unison_http_duration_seconds_count[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(unison_http_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Очередь и обработка аудио",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "unison_audio_queue_depth",
          "legendFormat": "В очереди",
          "refId": "A"
        },
        {
          "expr": "unison_audio_processing",
          "legendFormat": "Обрабатывается",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Дрейф воспроизведения p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(unison_stable_abs_drift_milliseconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Оповещения",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "unison-prometheus"
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
