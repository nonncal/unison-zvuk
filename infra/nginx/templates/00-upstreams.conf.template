# Load shared definitions before server blocks and re-resolve recreated services.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream unison_api {
    zone unison_api 64k;
    server api:8000 resolve;
}
upstream unison_storage {
    zone unison_storage 64k;
    server storage:9000 resolve;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# Do not log URLs: S3 query strings contain credentials and WS tickets are private.
log_format unison '$remote_addr $request_method $status $body_bytes_sent $request_time';
